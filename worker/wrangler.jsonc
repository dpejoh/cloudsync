{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudsync",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "CLOUDSYNC_BUCKET",
      "bucket_name": "cloudsync-vault"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CLOUDSYNC_KV",
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  "vars": {
    "JWT_SECRET": "cloudsync-default-super-secret-key-change-me"
  }
}
