{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cloudsync",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "r2_buckets": [
    {
      "binding": "CLOUDSYNC_BUCKET",
      "bucket_name": "cloudsync-vault"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CLOUDSYNC_KV",
      "id": "34ddb4d814844e0f8a4fafd5f2d5ef2c"
    }
  ],
  "vars": {
    "JWT_SECRET": "cloudsync-secret-666038b93c147fe3124f2908980e1f44"
  }
}
