{
  "name": "cloudsync-worker",
  "version": "1.0.0",
  "description": "Cloudflare Worker sync engine for CloudSync Obsidian plugin",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build:vps": "esbuild src/standalone.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/server.mjs --external:node:*",
    "start:vps": "node dist/server.mjs",
    "test:vps": "npm run build:vps && node src/vps/test-vps.mjs"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.1",
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "esbuild": "^0.17.19",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.0"
  }
}
