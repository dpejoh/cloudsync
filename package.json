{
  "name": "obsidian-cloudsync",
  "version": "1.0.0",
  "description": "Fast, zero-friction, end-to-end encrypted note synchronization powered by Cloudflare Workers & R2.",
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "node esbuild.config.mjs production",
    "build-check": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "format": "npx @biomejs/biome check --write .",
    "clean": "npx rimraf main.js"
  },
  "browser": {
    "path": "path-browserify",
    "process": "process/browser",
    "stream": "stream-browserify",
    "crypto": "crypto-browserify",
    "url": "url/",
    "fs": false,
    "vm": false
  },
  "source": "src/main.ts",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "sync",
    "cloudflare",
    "r2",
    "e2ee"
  ],
  "author": "dpejoh",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/lodash": "^4.17.7",
    "@types/mime-types": "^2.1.4",
    "@types/mustache": "^4.2.5",
    "@types/node": "^20.14.12",
    "@types/qrcode": "^1.5.5",
    "dotenv": "^16.4.5",
    "esbuild": "^0.23.0",
    "esbuild-plugin-inline-worker": "^0.1.1",
    "obsidian": "^1.5.7",
    "rimraf": "^6.0.1",
    "tslib": "^2.6.3",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@fyears/rclone-crypt": "^0.0.7",
    "@fyears/tsqueue": "^1.0.1",
    "aggregate-error": "^5.0.0",
    "assert": "^2.1.0",
    "buffer": "^6.0.3",
    "crypto-browserify": "^3.12.0",
    "http-status-codes": "^2.3.0",
    "localforage": "^1.10.0",
    "localforage-getitems": "^1.4.2",
    "localforage-removeitems": "^1.4.0",
    "lodash": "^4.17.21",
    "lucide": "^0.416.0",
    "mime-types": "^2.1.35",
    "mustache": "^4.2.0",
    "nanoid": "^5.0.7",
    "p-queue": "^8.0.1",
    "path-browserify": "^1.0.1",
    "process": "^0.11.10",
    "qrcode": "^1.5.3",
    "rfc4648": "^1.5.3",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.4",
    "util": "^0.12.5",
    "xregexp": "^5.1.1"
  }
}
